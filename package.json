{
  "name": "biblecommit",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @biblecommit/db db:migrate",
    "db:seed": "pnpm --filter @biblecommit/db db:seed",
    "gen:api": "pnpm --filter @biblecommit/web gen:api"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
